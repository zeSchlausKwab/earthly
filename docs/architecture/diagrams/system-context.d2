grid-columns: 1

classes: {
  entry: {
    style.fill: "#fff3c4"
    style.stroke: "#a86f00"
    style.stroke-width: 2
  }
  core: {
    style.fill: "#e8f2ff"
    style.stroke: "#2869a6"
  }
  state: {
    style.fill: "#ebf8ef"
    style.stroke: "#31834e"
  }
  seam: {
    style.fill: "#f2eaff"
    style.stroke: "#7652a8"
    style.stroke-width: 2
  }
  external: {
    style.fill: "#f4f4f4"
    style.stroke: "#686868"
  }
}

clients: "Clients" {
  grid-columns: 2
  web: "Web browser" { class: entry }
  android: "Android app\nTauri WebView" { class: entry }
}

application: "Shared Earthly application" {
  direction: down
  shell: "React application shell\nrouting · responsive UI · feature coordination" { class: core }
  capabilities: "Product capabilities\nmap editor · social entities · AI chat\nprivate groups · field sessions" { class: core }
  data: "Client-owned state\nEventStore · editor store · accounts · drafts" { class: state }

  shell -> capabilities -> data
}

delivery: "Delivery and storage" {
  grid-columns: 2

  network: "Network services" {
    grid-columns: 2
    nostr: "Nostr relays\npublic records + ContextVM transport" { class: external }
    blossom: "Blossom servers\nimages · files · PMTiles" { class: external }
    coordination: "Private and geo services\nCordn coordinator · Earthly MCP" { class: external }
    models: "Model providers\nRoutstr · local · custom" { class: external }
  }

  native: "Android local runtime" {
    direction: down
    bridge: "Validated Tauri platform bridge" { class: seam }
    node: "Embedded Earthly node\nidentity · pairing · relay · Blossom" { class: seam }
    durable: "Native durable state\npublish outbox · saved regions" { class: state }

    bridge -> node
    bridge -> durable
  }
}

clients -> application: "same frontend"
application -> delivery.network: "online delivery and services"
application -> delivery.native: "Android capabilities and verified local data"
