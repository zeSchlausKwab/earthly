{
  "name": "earthly",
  "version": "0.1.3",
  "description": "Collaborative geographic mapping on Nostr",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init --ci",
    "tauri:android:build": "tauri android build --apk --ci",
    "tauri:android:install:dev": "bun run scripts/install-android-dev.ts",
    "tauri:android:install:optimized": "bun run scripts/install-android-dev.ts --optimized",
    "e2e:android:list": "bun run scripts/android-e2e.ts list",
    "e2e:android:emulator": "bun run scripts/android-e2e.ts emulator",
    "e2e:android:smoke": "bun run scripts/android-e2e.ts smoke",
    "release:android:check": "bun run scripts/android-release.ts check",
    "release:android:build": "bun run scripts/android-release.ts build",
    "release:zapstore:check": "zsp publish --check zapstore.yaml",
    "release:zapstore:publish": "zsp publish zapstore.yaml",
    "tauri:frontend": "bun --hot src/index.ts --host 0.0.0.0",
    "dev": "./scripts/dev-clean.sh",
    "seed": "bun run scripts/seed.ts",
    "seed:entities": "bun run scripts/seed.ts full",
    "seed:sightings": "bun run scripts/seed.ts sightings",
    "relay": "cd relay && go run . --port 3334",
    "cordn:dev": "./scripts/cordn-dev.sh",
    "relay:reset": "./scripts/kill-relay.sh && cd relay && go run . --reset-all",
    "relay:kill": "./scripts/kill-relay.sh",
    "searxng:dev": "bash ops/vps/searxng.sh start",
    "searxng:stop": "bash ops/vps/searxng.sh stop",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "build:production": "./scripts/build-production.sh",
    "validate:production": "bun run scripts/validate-production-env.ts",
    "setup:vps": "bash ops/vps/setup.sh",
    "deploy": "bash ops/vps/deploy.sh",
    "deploy:check": "bash ops/vps/deploy.sh --check",
    "tools:pmtiles": "bash scripts/ensure-pmtiles.sh",
    "clean:artifacts": "bash scripts/clean-artifacts.sh --dry-run",
    "clean:artifacts:apply": "bash scripts/clean-artifacts.sh --apply",
    "ctxcn:update": "ctxcn update ceadb7d5b739189fb3ecb7023a0c3f55d8995404d7750f5068865decf8b304cc",
    "ctxcn:verify": "bun run scripts/verify-ctxcn-client.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:private-maps": "bun build scripts/private-maps-mls-smoke.ts --target=node --outfile=.cache/private-maps-mls-smoke.mjs && node .cache/private-maps-mls-smoke.mjs && bun build scripts/private-maps-delayed-echo-smoke.ts --target=node --outfile=.cache/private-maps-delayed-echo-smoke.mjs && node .cache/private-maps-delayed-echo-smoke.mjs && bun build scripts/private-maps-established-join-smoke.ts --target=node --outfile=.cache/private-maps-established-join-smoke.mjs && node .cache/private-maps-established-join-smoke.mjs",
    "ai:list": "bun run ai-suite/catalog.ts",
		"chat:analyze": "bun run scripts/analyze-chat-dump.ts",
    "experience:list": "bun run ai-suite/experience-lab/catalog.ts",
    "experience:card": "bun run ai-suite/experience-lab/session-card.ts",
    "experience:audit": "playwright test -c ai-suite/playwright.config.ts --grep @experience-audit",
    "experience:audit:ai": "playwright test -c ai-suite/playwright.config.ts --grep @ai-journey --grep-invert @live-ai --workers=1",
    "experience:audit:ai:live": "playwright test -c ai-suite/playwright.config.ts --grep @live-ai",
    "ai:typecheck": "tsc -p ai-suite/tsconfig.json --noEmit",
    "ai:e2e": "playwright test -c ai-suite/playwright.config.ts --grep-invert '@audit|@workflow-audit|@experience-audit'",
    "ai:e2e:editor": "playwright test -c ai-suite/playwright.config.ts --grep @editor-contract",
    "ai:audit": "playwright test -c ai-suite/playwright.config.ts --grep @audit",
    "ai:audit:editor": "playwright test -c ai-suite/playwright.config.ts --grep @editor-ux-audit",
    "ai:audit:workflows": "playwright test -c ai-suite/playwright.config.ts --grep @workflow-audit",
    "ai:known-issues": "playwright test -c ai-suite/playwright.config.ts --grep @known-issue --pass-with-no-tests",
    "ai:verify": "bun run ai:typecheck && bun run ai:e2e && bun run ai:audit",
    "ai:e2e:visible": "playwright test -c ai-suite/playwright.config.ts --grep-invert '@audit|@workflow-audit|@experience-audit'",
    "ai:e2e:ui": "playwright test -c ai-suite/playwright.config.ts --ui",
    "docs:diagrams": "./scripts/render-architecture-diagrams.sh"
  },
