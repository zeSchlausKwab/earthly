{
  "name": "earthly",
  "version": "0.1.0",
  "description": "Collaborative geographic mapping on Nostr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev-clean.sh",
    "seed": "bun run scripts/seed.ts",
    "seed:entities": "bun run scripts/seed-entities.ts",
    "seed:sightings": "bun run scripts/seed-sightings.ts",
    "seed:canonical": "bun run scripts/seed_canonical_data.ts",
    "purge:canonical": "bun run scripts/purge_canonical_data.ts",
    "relay": "cd relay && go run . --port 3334",
    "relay:reset": "./scripts/kill-relay.sh && cd relay && go run . --reset-all",
    "relay:kill": "./scripts/kill-relay.sh",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "build:production": "./scripts/build-production.sh",
    "setup:vps": "./scripts/setup-vps.sh",
    "deploy": "./scripts/deploy.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test"
  },
