# Android release signing configuration for Earthly Native (apps/native/android).
#
# Copy this file to `apps/native/android/keystore.properties` (gitignored) and fill
# in your release keystore details before building a signed local release APK/AAB.
#
# To generate a release keystore outside the repository:
#   keytool -genkeypair -v -keystore ~/earthly-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias earthly
#
# Alternatively (for example in CI), provide these environment variables instead
# of creating `keystore.properties`:
#   ANDROID_KEYSTORE_PATH
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
#
# When neither `keystore.properties` nor the environment variables point to an
# existing keystore file, `buildTypes.release` automatically falls back to debug
# signing so local developer builds work out of the box.

storeFile=/absolute/path/to/earthly-release.jks
storePassword=CHANGE_ME
keyAlias=earthly
keyPassword=CHANGE_ME
