# Local deployment target. Copy to .env.deploy; never put production keys in this file.
VPS_HOST=earthly.example
VPS_USER=deploy
VPS_PATH=/var/www/earthly

# Default pinned Overture release for a missing-catalog bootstrap or an explicit
# --update-geocatalog without a release argument.
GEOCATALOG_OVERTURE_RELEASE=2026-08-19.0
