# Copy to .env.production and replace every CHANGE_ME value.
# This file is loaded both for the browser build and on the VPS.
NODE_ENV=production

RELAY_URL=wss://relay.earthly.city
EXTRA_READ_RELAYS=
BLOSSOM_SERVER=https://blossom.earthly.city

# Earthly geo ContextVM identity. The public key must derive from the private key.
SERVER_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
SERVER_PUBKEY=CHANGE_ME_64_HEX_PUBLIC_KEY
APP_PRIVATE_KEY=

# Cordn is a ContextVM server over Nostr; it has no public HTTP endpoint.
CORDN_SERVER_PRIVATE_KEY=CHANGE_ME_DISTINCT_64_HEX_PRIVATE_KEY
CORDN_SERVER_PUBKEY=CHANGE_ME_DERIVED_64_HEX_PUBLIC_KEY
CORDN_RELAY_URLS=wss://relay.earthly.city
CORDN_IMAGE=ghcr.io/cordn-msg/cordn:v0.4.0
CORDN_ANNOUNCED=false
CORDN_SERVER_NAME=earthly-cordn

# Persistent coordinator state inside the mounted container volume.
CORDN_STORAGE_BACKEND=sqlite
CORDN_SQLITE_PATH=/data/cordn.sqlite
CORDN_MAX_AGE_DAYS=30

# Coordinator abuse controls.
CORDN_RATE_LIMIT_ENABLED=true
CORDN_RATE_LIMIT_REFILL_PER_MINUTE=500
CORDN_RATE_LIMIT_BURST=160
CORDN_RATE_LIMIT_IDLE_TTL_SECONDS=3600
CORDN_MAX_KEY_PACKAGES_PER_IDENTITY=50
CORDN_MAX_LAST_RESORT_KEY_PACKAGES_PER_IDENTITY=1
CORDN_LOG_ABUSE_REJECTIONS=true
