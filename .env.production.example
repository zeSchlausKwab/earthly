# Copy to .env.production and replace every CHANGE_ME value.
# This file is loaded both for the browser build and on the VPS.
NODE_ENV=production

RELAY_URL=wss://relay.earthly.city
EXTRA_READ_RELAYS=wss://nos.lol,wss://relay.nostr.net
PUBLIC_BASE_URL=https://earthly.city
BLOSSOM_SERVER=https://blossom.earthly.city
MAPNOLIA_TRUSTED_PUBKEYS=58f35635deac8768c0412484baab3462963053cf67384495bae29b114dec083f
# Public authors eligible for the Discover catalog. This is independent from
# Mapnolia trust. An empty production list safely promotes no public content.
DISCOVERY_FEATURED_PUBKEYS=a727520f3be635df49d96a9a5a8585b1eda4e0cd5a53842943bac34d6dd0b62f,4e0b499afcc7641c0526e318fc41a93bdd7412a06e47e9e84b3d96575d402179

# Earthly geo ContextVM identity. The public key must derive from the private key.
SERVER_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
SERVER_PUBKEY=CHANGE_ME_64_HEX_PUBLIC_KEY
APP_PRIVATE_KEY=

# Private loopback-only SearXNG used by the ContextVM web_search tool.
SEARXNG_URL=http://127.0.0.1:8888

# Optional override for the immutable geography snapshot. The default resolves
# through the release's persistent data symlink.
GEOCATALOG_PATH=./data/geocatalog/current.sqlite

# Cordn-rs is a native ContextVM server over Nostr; it has no public HTTP endpoint.
CORDN_SERVER_PRIVATE_KEY=CHANGE_ME_DISTINCT_64_HEX_PRIVATE_KEY
CORDN_SERVER_PUBKEY=CHANGE_ME_DERIVED_64_HEX_PUBLIC_KEY
CORDN_RELAY_URLS=wss://relay.earthly.city
CORDN_ANNOUNCED=false
CORDN_SERVER_NAME=earthly-cordn

# Persistent coordinator state on the VPS. The deploy script pins and verifies cordn-rs v0.4.0.
CORDN_STORAGE_BACKEND=sqlite
CORDN_NATIVE_SQLITE_PATH=data/cordn/cordn.sqlite
CORDN_SQLITE_SYNCHRONOUS=full
CORDN_MAX_AGE_DAYS=30

# Coordinator abuse controls.
CORDN_RATE_LIMIT_ENABLED=true
CORDN_RATE_LIMIT_REFILL_PER_MINUTE=500
CORDN_RATE_LIMIT_BURST=160
CORDN_RATE_LIMIT_IDLE_TTL_SECONDS=3600
CORDN_MAX_KEY_PACKAGES_PER_IDENTITY=50
CORDN_MAX_LAST_RESORT_KEY_PACKAGES_PER_IDENTITY=1
CORDN_LOG_ABUSE_REJECTIONS=true
